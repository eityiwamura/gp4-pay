<aside class="sidebar no-print" id="sidebar">
  <div class="sidebar-header">
    <a href="/" class="brand" style="text-decoration:none;color:white;">
      <span>GP4</span><span class="dot">·</span><span class="label">Taxas</span>
    </a>
    <button class="sidebar-toggle" id="sidebarToggle" type="button" title="Recolher/expandir menu" aria-label="Recolher ou expandir o menu">
      <span id="sidebarToggleIcon" aria-hidden="true">‹</span>
    </button>
  </div>

  <nav class="sidebar-nav">
    <a href="/" class="<%= typeof active !== 'undefined' && active === 'home' ? 'active' : '' %>">
      <%- include('icon', { name: 'home' }) %><span class="label">Início</span>
    </a>
    <% if (can(user, 'calculator')) { %>
      <a href="/calculator" class="<%= typeof active !== 'undefined' && active === 'calculator' ? 'active' : '' %>">
        <%- include('icon', { name: 'calculator' }) %><span class="label">Calculadora</span>
      </a>
    <% } %>
    <% if (can(user, 'rates')) { %>
      <a href="/rates" class="<%= typeof active !== 'undefined' && active === 'rates' ? 'active' : '' %>">
        <%- include('icon', { name: 'rates' }) %><span class="label">Cadastro de Taxas</span>
      </a>
    <% } %>
    <% if (can(user, 'users')) { %>
      <a href="/users" class="<%= typeof active !== 'undefined' && active === 'users' ? 'active' : '' %>">
        <%- include('icon', { name: 'users' }) %><span class="label">Usuários</span>
      </a>
    <% } %>
    <% if (user && user.role === 'admin') { %>
      <a href="/rastreabilidade" class="<%= typeof active !== 'undefined' && active === 'trace' ? 'active' : '' %>">
        <%- include('icon', { name: 'trace' }) %><span class="label">Rastreabilidade</span>
      </a>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <%= user ? user.name : '' %>
      <% if (user && user.role === 'admin') { %><span class="sidebar-role">Administrador</span><% } %>
    </div>
    <form method="POST" action="/logout">
      <button class="logout" type="submit">
        <%- include('icon', { name: 'logout' }) %><span class="label">Sair</span>
      </button>
    </form>
  </div>
</aside>

<script src="/js/sidebar.js"></script>
