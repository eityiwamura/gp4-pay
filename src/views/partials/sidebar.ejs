<aside class="sidebar no-print" id="sidebar">
  <div class="sidebar-header">
    <a href="/" class="brand" style="text-decoration:none;color:white;">
      <span>GP4</span><span class="dot">·</span><span class="label">Taxas</span>
    </a>
    <button class="sidebar-toggle" id="sidebarToggle" type="button" title="Recolher/expandir menu">
      <span id="sidebarToggleIcon">‹</span>
    </button>
  </div>

  <nav class="sidebar-nav">
    <a href="/" class="<%= typeof active !== 'undefined' && active === 'home' ? 'active' : '' %>">
      <span class="icon">🏠</span><span class="label">Início</span>
    </a>
    <a href="/calculator" class="<%= typeof active !== 'undefined' && active === 'calculator' ? 'active' : '' %>">
      <span class="icon">🧮</span><span class="label">Calculadora</span>
    </a>
    <% if (user && user.role === 'admin') { %>
      <a href="/rates" class="<%= typeof active !== 'undefined' && active === 'rates' ? 'active' : '' %>">
        <span class="icon">⚙️</span><span class="label">Cadastro de Taxas</span>
      </a>
    <% } %>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user"><%= user ? user.name : '' %></div>
    <form method="POST" action="/logout">
      <button class="logout" type="submit">
        <span class="icon">↪</span><span class="label">Sair</span>
      </button>
    </form>
  </div>
</aside>

<script src="/js/sidebar.js"></script>
